# Itinerary Generator — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.

# LLM provider keys (choose based on config.yaml ai.provider or trip.llm.provider)

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_API_VERSION=2023-06-01
# ANTHROPIC_API_BASE=https://api.anthropic.com/v1/messages
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
#
# Optional: Claude as a search/harvest provider (generator/claude_search.py),
# selectable via config.yaml's url_discovery.search_provider /
# cultural_events.search_provider ("grok" default, or "claude"). Shares the
# ANTHROPIC_API_KEY/API_VERSION/API_BASE above -- same account as content
# generation. Network tuning and circuit breaker (optional -- defaults
# shown) mirror XAI_* below, kept in their own namespace since this is an
# independently-tripped breaker from both XAI_CIRCUIT_BREAKER_* and
# llm_client.py's LLM_CIRCUIT_BREAKER_*.
# ANTHROPIC_SEARCH_TIMEOUT_SECONDS=150
# ANTHROPIC_SEARCH_NETWORK_RETRIES=2
# ANTHROPIC_SEARCH_WARNING_COOLDOWN_SECONDS=30
# ANTHROPIC_SEARCH_CIRCUIT_BREAKER_THRESHOLD=4
# ANTHROPIC_SEARCH_CIRCUIT_BREAKER_WINDOW_SECONDS=30
# ANTHROPIC_SEARCH_CIRCUIT_BREAKER_COOLDOWN_SECONDS=15
# ANTHROPIC_SEARCH_MAX_TOKENS=4096

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-1.5-flash

# Azure OpenAI (legacy compatibility only)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# xAI Grok API (required for URL discovery and cultural events)
# Sign up free at: https://console.x.ai/
# Copy key from:   https://console.x.ai/ → API keys section
XAI_API_KEY=your-xai-api-key-here
# XAI_MODEL=grok-latest
#
# Network tuning (optional — defaults shown). Grok search/direct-batch calls can
# see transient read timeouts under load; these control how aggressively a
# single call retries before giving up.
# XAI_TIMEOUT_SECONDS=25
# XAI_NETWORK_RETRIES=2
# XAI_WARNING_COOLDOWN_SECONDS=30
#
# Circuit breaker (optional — defaults shown). If XAI_CIRCUIT_BREAKER_THRESHOLD
# transient errors land within XAI_CIRCUIT_BREAKER_WINDOW_SECONDS, later calls
# fail fast for XAI_CIRCUIT_BREAKER_COOLDOWN_SECONDS instead of each
# independently waiting out a full timeout+retry cycle against a struggling API.
# Sized to the search-harvest call profile: 25s per-attempt timeout, max 4
# concurrent (_GROK_SEMAPHORE) -- see grok_search.py for the full derivation.
# XAI_CIRCUIT_BREAKER_THRESHOLD=4
# XAI_CIRCUIT_BREAKER_WINDOW_SECONDS=30
# XAI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=15
#
# Separate circuit breaker for content-generation LLM calls (destination text,
# schedule, attractions -- via llm_client.py, distinct from the xAI search
# breaker above even when ai.provider is also grok). Sized differently: 60s
# per-attempt timeout, and concurrency here can be as low as 1 (sequential)
# when ai.provider: grok, since grok_max_concurrent_destinations defaults to
# 1 -- see llm_client.py for the full derivation.
# LLM_CIRCUIT_BREAKER_THRESHOLD=3
# LLM_CIRCUIT_BREAKER_WINDOW_SECONDS=180
# LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=45

# NPS API (optional — DEMO_KEY used if omitted, but rate-limited)
# Free key (email arrives in minutes): https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=your-nps-api-key-here

# ── Reservation email ingestion (scripts/ingest_reservations.py) ──────────────
# A dedicated mailbox that forwarded hotel/flight/train/car confirmations land
# in. Nothing here is needed for a normal build -- the generator only reads the
# sidecar the ingest script produces, never the mailbox.
#
# Use an APP PASSWORD, not your account password: this grants full mailbox read
# access, so point it at a purpose-made address rather than your personal inbox.
# Gmail: https://myaccount.google.com/apppasswords (requires 2FA enabled).
#   host = imap.gmail.com   |  Fastmail: imap.fastmail.com  |  iCloud: imap.mail.me.com
# RESERVATION_IMAP_HOST=imap.gmail.com
# RESERVATION_IMAP_USER=trips@example.com
# RESERVATION_IMAP_PASSWORD=your-16-character-app-password
#   Google displays app passwords as four space-separated groups of four.
#   The credential is the 16 characters; spaces are display formatting only.
#   Either form works here -- they are stripped for Google/iCloud hosts.
#   NOT your account password: Google removed less-secure-app access in
#   2022, so basic-auth IMAP requires an app password, which in turn
#   requires 2-Step Verification to be enabled on the account.
#
# Multi-trip routing: plus-addressing keeps one mailbox serving many trips --
# forward to trips+sw@example.com vs trips+japan@example.com and poll with a
# different --mailbox (server-side filter into a folder per trip).

# ── Google Maps Platform (optional) ───────────────────────────────────────────
# Unset by default and unnecessary for normal operation. When set, secondary map
# links become precise place_id links rather than text searches.
# Needs "Places API (New)" enabled and permitted on the key.
# GOOGLE_MAPS_PLATFORM_KEY=
